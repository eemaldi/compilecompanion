{
  "extends": "../../tooling/tsconfig/base.json",
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "types": ["node"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "noEmit": true,
    "incremental": true,
    "allowJs": false,
    "plugins": [{ "name": "next" }]
  },
  "include": ["next-env.d.ts", "app", "vitest.config.mts", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
